# Copy this file to .streamlit/secrets.toml and fill in your own values.
# NEVER commit the real secrets.toml file to version control.

[mysql]
host = "mysql-xxxx.aivencloud.com"
port = 15575
user = "avnadmin"
password = "your-password-here"
db = "defaultdb"
connect_timeout = 10
read_timeout = 10
write_timeout = 10
